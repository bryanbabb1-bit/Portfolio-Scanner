# Copy to .env (or export) to configure the backend.

# Data source mode:
#   auto  -> try Yahoo Finance (yfinance), fall back to mock if unreachable (default)
#   live  -> force live yfinance (errors surface)
#   mock  -> deterministic mock data (great for demos / offline / CI)
DATA_MODE=auto

# Seconds to cache market data per symbol in-process.
CACHE_TTL=300

# AI advisor via the local `claude` CLI (uses your signed-in subscription).
ADVISOR_ENABLED=true
CLAUDE_BIN=claude
# Optional model override for the advisor (blank = CLI default):
# CLAUDE_MODEL=claude-sonnet-5
ADVISOR_TIMEOUT=120
ADVISOR_CACHE_TTL=3600

# Comma-separated CORS origins for the frontend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
